# ==============================================================================
# IRYX Platform - Environment Variables Template
# ==============================================================================
# All sensitive variables must be set securely in production environments.
# Never commit the actual .env file containing real secrets.
# ==============================================================================

# Application Configuration
APP_NAME=IRYX API
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=false
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]
LOG_LEVEL=INFO

# Security & Authentication (ADR-0006, D-12, D-13)
# SECRET_KEY is mandatory and must be a 32+ character random string in production (e.g. openssl rand -hex 32)
SECRET_KEY=change-me-in-production-use-a-strong-secret-key-32-chars-min
# Valeur de développement uniquement : ENVIRONMENT=production refuse cette valeur par défaut.
JWT_SECRET_KEY=change-me-in-production-use-a-strong-jwt-secret-key
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database Configuration (PostgreSQL 16, D-05, D-06)
# Usage local hors Docker. Compose remplace cette URL par les hôtes internes :
# postgresql+psycopg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}
DATABASE_URL=postgresql+psycopg://iryx:iryx_password@localhost:5432/iryx_db

# Paramètres du service PostgreSQL de docker-compose.yml (D-22).
# Remplacez POSTGRES_PASSWORD par une valeur robuste dans backend/.env (jamais commité).
# La valeur doit rester URL-safe (éviter @, /, :, #) : elle est interpolée dans DATABASE_URL.
# Ces valeurs sont aussi utilisées par l'entrypoint API pour sa sonde pg_isready.
POSTGRES_USER=iryx
POSTGRES_PASSWORD=change-me-in-production-use-a-strong-password
POSTGRES_DB=iryx_db

# Réglages optionnels de la sonde de l'entrypoint API (valeurs par défaut).
# POSTGRES_HOST=postgres
# POSTGRES_PORT=5432
# PG_READY_TIMEOUT_SECONDS=60

# Asynchronous Tasks & Cache (Celery & Redis 7, D-08)
# Usage local hors Docker. Compose remplace ces URL par redis://redis:6379/0.
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Forensic Evidence Storage (ADR-0005, ADR-0010)
# Sous Compose, le volume nommé evidence_data couvre /data/evidence et son
# sous-répertoire staging (EVIDENCE_STAGING_PATH dérivé automatiquement sinon).
EVIDENCE_STORAGE_PATH=/data/evidence/
MAX_EVIDENCE_SIZE_GB=16

# LLM Providers Configuration (D-10, D-11, docs/07)
OPENAI_API_BASE=https://api.groq.com/openai/v1
OPENAI_API_KEY=dummy-key-for-local-dev
PLANNER_MODEL=llama-3.3-70b-versatile
ANALYST_MODEL=llama-3.3-70b-versatile
RAPPORTEUR_MODEL=llama-3.3-70b-versatile
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=3

# Polling Configuration (ADR-0008, D-24)
POLLING_RETRY_AFTER_SECONDS=3

# Forensic Tool Confinement & Symbols (D-26)
# L'archive backend/docker/symbols/windows.zip doit être fournie localement
# avant le build de l'image worker ; aucun téléchargement réseau de symboles.
VOLATILITY_SYMBOLS_PATH=/opt/volatility3/symbols
